#  §6  BUY / SELL LABELLER  (replicates notebook logic)
# ══════════════════════════════════════════════════════════════════════════════

class BuySellLabeller:
    """
    Target weights → action labels.

    Thresholds (relative to current weight)
    ─────────────────────────────────────────
    delta > +add_thresh  * 2   →  Buy       (High conviction)
    delta > +add_thresh        →  Buy       (Medium conviction)
    delta > +hold_thresh       →  Add
    |delta| <= hold_thresh     →  Hold
    delta < -hold_thresh       →  Reduce    (Low)
    delta < -add_thresh        →  Reduce    (Medium/High)
    target < sell_thresh       →  Sell-Avoid
    """

    def __init__(self, add_thresh=0.03, hold_thresh=0.01, sell_thresh=0.005):
        self.add_thresh  = add_thresh
        self.hold_thresh = hold_thresh
        self.sell_thresh = sell_thresh

    def label(self, tickers, current_weights, target_weights) -> pd.DataFrame:
        delta = target_weights - current_weights
        rows  = []
        for t, cur, tgt, d in zip(tickers, current_weights, target_weights, delta):
            if tgt < self.sell_thresh:
                action, conv = "Sell-Avoid", "High"
            elif d > self.add_thresh * 2:
                action, conv = "Buy", "High"
            elif d > self.add_thresh:
                action, conv = "Buy", "Medium"
            elif d > self.hold_thresh:
                action, conv = "Add", "Medium"
            elif d < -self.add_thresh * 2:
                action, conv = "Reduce", "High"
            elif d < -self.add_thresh:
                action, conv = "Reduce", "Medium"
            elif d < -self.hold_thresh:
                action, conv = "Reduce", "Low"
            else:
                action, conv = "Hold", "Low"
            rows.append({"ticker":t, "current_weight":round(cur,4),
                         "target_weight":round(tgt,4), "delta":round(d,4),
                         "action":action, "conviction":conv})
        return (pd.DataFrame(rows)
                .sort_values(["action","conviction"])
                .reset_index(drop=True))


