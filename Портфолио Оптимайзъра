#  §2  ASSET SCREENER
# ══════════════════════════════════════════════════════════════════════════════

class AssetScreener:
    """Select top-N assets by annualised Sharpe-like score — replicates notebook."""

    def __init__(self, top_n: int = 20):
        self.top_n = top_n

    def screen(self, returns: np.ndarray, tickers: List[str]):
        mu     = returns.mean(axis=0)
        sig    = returns.std(axis=0, ddof=1).clip(min=1e-9)
        sharpe = (mu / sig) * np.sqrt(12)
        scores = pd.DataFrame({
            "ticker":        tickers,
            "mean_monthly":  np.round(mu, 6),
            "vol_monthly":   np.round(sig, 6),
            "sharpe_annual": np.round(sharpe, 4),
        }).sort_values("sharpe_annual", ascending=False).reset_index(drop=True)

        top_tickers = scores["ticker"].iloc[:self.top_n].tolist()
        orig_idx    = [tickers.index(t) for t in top_tickers]
        log.info(f"Screened {len(tickers)} → {len(top_tickers)} assets.")
        return returns[:, orig_idx], top_tickers, scores


