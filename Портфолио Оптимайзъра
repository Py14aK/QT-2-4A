#  §3  PORTFOLIO QUBO
# ══════════════════════════════════════════════════════════════════════════════

class PortfolioQUBO:
    """
    Encode long-only portfolio optimisation as a QUBO.

    Weight encoding: each asset i gets K binary variables.
    Weight_i = Σ_k (2^k / (2^K-1)) * w_{i,k}   (binary encoding)
    Total vars: N * K

    Objectives:  "cvar" | "sharpe" | "var"
    Constraints: budget (Σw=1) + max-weight (w_i <= w_max), both as penalties.

    CVaR QUBO approximation
    -----------------------
    True CVaR optimisation requires auxiliary variables for the tail samples,
    which blows up variable count for large T.  We use the parametric normal
    approximation:  CVaR_alpha(w) ≈ -w'μ + z_cvar * sqrt(w'Σw)
    where z_cvar = φ(Φ⁻¹(α)) / (1-α).  This is exact when returns are
    normal and a conservative upper bound otherwise.
    """

    def __init__(self, returns, tickers, K=3, alpha=0.95, w_max=0.25,
                 penalty=50.0, objective="cvar"):
        self.returns   = returns
        self.tickers   = tickers
        self.T, self.N = returns.shape
        self.K, self.alpha, self.w_max  = K, alpha, w_max
        self.penalty   = penalty
        self.objective = objective
        self.mu        = returns.mean(axis=0)
        self.cov       = np.cov(returns.T, ddof=1)

    def _vn(self, i, k): return f"w_{i}_{k}"
    def _wc(self, k):    return (2**k) / ((2**self.K) - 1)

    def _reset(self):
        self._C = 0.0; self._L = {}; self._Q = {}

    def _al(self, v, c):
        self._L[v] = self._L.get(v, 0.0) + c

    def _aq(self, a, b, c):
        key = tuple(sorted((a, b)))
        self._Q[key] = self._Q.get(key, 0.0) + c

    def _quad_form(self, M, scale):
        """Add scale * w'Mw to the objective."""
        for i in range(self.N):
            for j in range(self.N):
                for ki in range(self.K):
                    for kj in range(self.K):
                        c = scale * M[i, j] * self._wc(ki) * self._wc(kj)
                        if i == j and ki == kj:
                            self._al(self._vn(i, ki), c)
                        else:
                            self._aq(self._vn(i, ki), self._vn(j, kj), c)

    def _linear_form(self, v, scale):
        """Add scale * w'v to the objective."""
        for i in range(self.N):
            for k in range(self.K):
                self._al(self._vn(i, k), scale * v[i] * self._wc(k))

    def _budget_penalty(self):
        """(Σ_i Σ_k wc_k * w_{i,k} - 1)^2 * penalty."""
        P  = self.penalty
        av = [(self._vn(i, k), self._wc(k))
              for i in range(self.N) for k in range(self.K)]
        self._C += P
        for v, c in av:
            self._al(v, P * (c**2 - 2*c))
        for (v1,c1),(v2,c2) in itertools.combinations(av, 2):
            self._aq(v1, v2, 2*P*c1*c2)

    def _maxweight_penalty(self):
        """Soft penalty for each asset's weight exceeding w_max."""
        P = self.penalty * 0.5
        for i in range(self.N):
            av = [(self._vn(i,k), self._wc(k)) for k in range(self.K)]
            self._C += P * self.w_max**2
            for v, c in av:
                self._al(v, P*(c**2 - 2*c*self.w_max))
            for (v1,c1),(v2,c2) in itertools.combinations(av, 2):
                self._aq(v1, v2, 2*P*c1*c2)

    def build(self) -> QuadraticProgram:
        self._reset()
        qp = QuadraticProgram(name=f"Port_{self.objective}")
        for i in range(self.N):
            for k in range(self.K):
                qp.binary_var(self._vn(i, k))

        if self.objective == "cvar":
            z = norm.pdf(norm.ppf(self.alpha)) / (1 - self.alpha)
            self._linear_form(-self.mu, 1.0)
            self._quad_form(self.cov, z)
        elif self.objective == "sharpe":
            self._linear_form(-self.mu, 1.0)   # negate → minimise -Sharpe
            self._quad_form(self.cov, 1.0)
        elif self.objective == "var":
            z = norm.ppf(self.alpha)
            self._linear_form(-self.mu, 1.0)
            self._quad_form(self.cov, z)
        else:
            raise ValueError(f"Unknown objective '{self.objective}'")

        self._budget_penalty()
        self._maxweight_penalty()
        qp.minimize(constant=self._C, linear=self._L, quadratic=self._Q)
        log.info(f"QUBO: {self.N*self.K} vars, objective={self.objective}")
        return qp

    def decode_weights(self, x) -> np.ndarray:
        w = np.zeros(self.N)
        for i in range(self.N):
            for k in range(self.K):
                idx = i*self.K + k
                if idx < len(x) and round(x[idx]) == 1:
                    w[i] += self._wc(k)
        s = w.sum()
        return w / s if s > 1e-9 else np.ones(self.N) / self.N


