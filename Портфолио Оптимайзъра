#  §5  CLASSICAL BENCHMARK
# ══════════════════════════════════════════════════════════════════════════════

class ClassicalBenchmark:
    """Scipy SLSQP solvers for CVaR, Sharpe, VaR — baseline for QAOA."""

    def __init__(self, returns, tickers, alpha=0.95, w_max=0.25):
        self.returns, self.tickers = returns, tickers
        self.T, self.N = returns.shape
        self.alpha, self.w_max = alpha, w_max
        self.mu  = returns.mean(axis=0)
        self.cov = np.cov(returns.T, ddof=1)

    def _cb(self):
        return ([(0, self.w_max)]*self.N,
                [{"type":"eq","fun":lambda w: w.sum()-1}])

    def _result(self, w, obj, solver):
        w = np.clip(w, 0, self.w_max); w /= w.sum()
        return PortfolioResult(objective=obj, weights=w, tickers=self.tickers,
                               solver=solver, **RiskMetrics.compute(self.returns, w))

    def solve_cvar(self):
        bounds, cons = self._cb()
        def f(w):
            r = self.returns @ w
            q = np.percentile(r, (1-self.alpha)*100)
            t = r[r <= q]
            return (-t.mean() if len(t) else -q)
        res = minimize(f, np.ones(self.N)/self.N, method="SLSQP",
                       bounds=bounds, constraints=cons, options={"maxiter":1000})
        return self._result(res.x, "cvar", "classical_cvar")

    def solve_sharpe(self):
        bounds, cons = self._cb()
        def f(w):
            r = self.returns @ w
            return -r.mean() / (r.std(ddof=1) + 1e-9)
        res = minimize(f, np.ones(self.N)/self.N, method="SLSQP",
                       bounds=bounds, constraints=cons, options={"maxiter":1000})
        return self._result(res.x, "sharpe", "classical_sharpe")

    def solve_var(self):
        bounds, cons = self._cb()
        z = norm.ppf(self.alpha)
        def f(w):
            return -(self.mu @ w) + z * np.sqrt(w @ self.cov @ w + 1e-12)
        res = minimize(f, np.ones(self.N)/self.N, method="SLSQP",
                       bounds=bounds, constraints=cons, options={"maxiter":1000})
        return self._result(res.x, "var", "classical_var")

    def equal_weight(self):
        return self._result(np.ones(self.N)/self.N, "equal_weight", "equal_weight")


