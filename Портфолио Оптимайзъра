#  §8  PORTFOLIO FACTORY  (full pipeline)
# ══════════════════════════════════════════════════════════════════════════════

class PortfolioFactory:
    """
    Full pipeline mirroring the notebook:
    CSV / synthetic → screen → QUBO → QAOA + classical → labels → report
    """

    def __init__(self, actions_path="/mnt/data/buy_sell_optimization_actions.csv",
                 stats_path="/mnt/data/buy_sell_optimization_strategy_stats.csv",
                 top_n=20, K=3, alpha=0.95, w_max=0.25,
                 quantum_cfg=None, use_quantum=True):
        self.top_n, self.K, self.alpha, self.w_max = top_n, K, alpha, w_max
        self.quantum_cfg = quantum_cfg or QuantumSolverConfig()
        self.use_quantum = use_quantum
        self.loader   = ReturnDataLoader(actions_path, stats_path)
        self.screener = AssetScreener(top_n=top_n)
        self.labeller = BuySellLabeller()

    def run(self):
        actions, stats, returns, tickers = self.loader.load()
        return self._execute(returns, tickers, actions)

    @classmethod
    def from_synthetic(cls, n_assets=30, n_months=60, top_n=20, K=3,
                       use_quantum=True, seed=42):
        factory = cls(top_n=top_n, K=K, use_quantum=use_quantum)
        actions, stats, returns, tickers = ReturnDataLoader.from_synthetic(
            n_assets, n_months, seed)
        return factory._execute(returns, tickers, actions)

    def _execute(self, returns, tickers, actions):
        sc_ret, sc_tick, scores = self.screener.screen(returns, tickers)

        # Current weights
        cur_w = np.ones(len(sc_tick)) / len(sc_tick)
        if "ticker" in actions.columns and "current_weight" in actions.columns:
            cw = dict(zip(actions["ticker"], actions["current_weight"]))
            cur_w = np.array([cw.get(t, 1/len(sc_tick)) for t in sc_tick])
            cur_w /= cur_w.sum()

        # Classical baselines
        bench   = ClassicalBenchmark(sc_ret, sc_tick, self.alpha, self.w_max)
        results = [bench.equal_weight(),
                   bench.solve_cvar(),
                   bench.solve_sharpe(),
                   bench.solve_var()]
        log.info("Classical baselines done.")

        # QAOA (optional)
        if self.use_quantum:
            qb     = PortfolioQUBO(sc_ret, sc_tick, self.K, self.alpha, self.w_max)
            solver = QuantumPortfolioSolver(self.quantum_cfg)
            for obj in ["cvar", "sharpe", "var"]:
                try:
                    results.append(solver.solve(qb, obj))
                except Exception as e:
                    log.warning(f"QAOA {obj} failed: {e}")

        # Label with best classical Sharpe result (notebook behaviour)
        best   = max((r for r in results if r.solver.startswith("classical")),
                     key=lambda r: r.sharpe)
        labels = self.labeller.label(sc_tick, cur_w, best.weights)
        comparison = RiskMetrics.comparison_table(results)
        return results, labels, comparison

    @staticmethod
    def print_report(labels, comparison):
        print("\n" + "="*65)
        print("  QUANTUM PORTFOLIO OPTIMIZER  |  Buy / Sell Actions")
        print("="*65)
        for action in ["Buy","Add","Hold","Reduce","Sell-Avoid"]:
            sub = labels[labels["action"]==action]
            if sub.empty: continue
            print(f"\n── {action} ({len(sub)}) ──")
            print(sub[["ticker","current_weight","target_weight",
                        "delta","conviction"]].to_string(index=False))
        print("\n" + "="*65)
        print("  STRATEGY COMPARISON")
        print("="*65)
        print(comparison[["solver","objective","sharpe","cvar_95",
                           "var_95","mean_return","volatility"]].to_string(index=False))


