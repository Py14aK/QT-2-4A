def demo_synthetic(use_quantum=False):
    """Full pipeline on synthetic data — no CSV files required.
    Set use_quantum=True when Qiskit is installed (N=20,K=3 → 60 QUBO vars)."""
    print("="*65)
    print("  Quantum Portfolio Optimizer  —  synthetic demo")
    print("="*65)
    results, labels, comparison = PortfolioFactory.from_synthetic(
        n_assets=30, n_months=60, top_n=20, K=3,
        use_quantum=use_quantum, seed=42)
    PortfolioFactory.print_report(labels, comparison)
    return results, labels, comparison


def demo_from_csv(actions_path="/mnt/data/buy_sell_optimization_actions.csv",
                  stats_path="/mnt/data/buy_sell_optimization_strategy_stats.csv",
                  use_quantum=False, ibm_token="", ibm_backend="ibm_brisbane"):
    """Run against the actual notebook CSV files.
    Flip use_quantum=True and set ibm_token for IBM cloud."""
    q_cfg = QuantumSolverConfig(reps=3, shots=8192, use_ibm=bool(ibm_token),
                                ibm_token=ibm_token, ibm_backend=ibm_backend)
    factory = PortfolioFactory(actions_path, stats_path,
                               top_n=20, K=3, quantum_cfg=q_cfg,
                               use_quantum=use_quantum)
    results, labels, comparison = factory.run()
    PortfolioFactory.print_report(labels, comparison)
    return results, labels, comparison


if __name__ == "__main__":
    results, labels, comparison = demo_synthetic(use_quantum=False)
