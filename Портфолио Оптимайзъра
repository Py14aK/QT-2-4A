class ReturnDataLoader:
    """
    Load the two CSVs from the notebook and expose a (T, N) return matrix.

    If monthly return columns (pattern r_YYYY-MM) exist in the actions CSV
    they are used directly.  Otherwise returns are reconstructed from
    mean_return + vol in the stats CSV (60-month simulation).
    """

    def __init__(
        self,
        actions_path: str = "/mnt/data/buy_sell_optimization_actions.csv",
        stats_path:   str = "/mnt/data/buy_sell_optimization_strategy_stats.csv",
    ):
        self.actions_path = Path(actions_path)
        self.stats_path   = Path(stats_path)

    def load(self) -> Tuple[pd.DataFrame, pd.DataFrame, np.ndarray, List[str]]:
        if not self.actions_path.exists() or not self.stats_path.exists():
            raise FileNotFoundError(
                "CSV files not found. Use PortfolioFactory.from_synthetic()."
            )
        actions = pd.read_csv(self.actions_path)
        stats   = pd.read_csv(self.stats_path)
        tickers = actions["ticker"].tolist() if "ticker" in actions.columns else []
        ret_cols = [c for c in actions.columns if c.startswith("r_")]
        if ret_cols and tickers:
            returns = actions[ret_cols].values.T.astype(float)
        else:
            log.warning("No monthly columns — reconstructing from stats.")
            returns = self._reconstruct(stats, n_months=60)
            tickers = tickers or [f"ASSET_{i}" for i in range(returns.shape[1])]
        log.info(f"Loaded: {returns.shape[1]} assets, {returns.shape[0]} months.")
        return actions, stats, returns, tickers

    @staticmethod
    def _reconstruct(stats: pd.DataFrame, n_months: int = 60) -> np.ndarray:
        rng = np.random.default_rng(42)
        n   = len(stats)
        mu  = stats["mean_return"].values if "mean_return" in stats.columns else np.full(n, 0.006)
        vol = stats["vol"].values         if "vol"         in stats.columns else np.full(n, 0.04)
        F   = rng.standard_normal(n_months)
        B   = rng.uniform(0.3, 0.9, n)
        return F[:, None] * B * 0.02 + rng.standard_normal((n_months, n)) * vol + mu / 12

    @staticmethod
    def from_synthetic(n_assets=30, n_months=60, seed=42):
        rng     = np.random.default_rng(seed)
        tickers = [f"TKR{i:02d}" for i in range(n_assets)]
        F  = rng.standard_normal((n_months, 3))
        B  = rng.uniform(-0.5, 1.2, (n_assets, 3))
        mu = rng.uniform(0.002, 0.012, n_assets)
        vol= rng.uniform(0.02, 0.08,  n_assets)
        returns = F @ B.T * 0.015 + rng.standard_normal((n_months, n_assets)) * vol + mu
        actions = pd.DataFrame({
            "ticker":         tickers,
            "current_weight": np.round(np.ones(n_assets) / n_assets, 4),
            "target_weight":  np.zeros(n_assets),
            "action":         ["Hold"] * n_assets,
        })
        stats = pd.DataFrame({
            "ticker":      tickers,
            "mean_return": mu, "vol": vol,
            "sharpe":      mu / vol,
            "var_95":      -norm.ppf(0.05) * vol,
            "cvar_95":     norm.pdf(norm.ppf(0.05)) / 0.05 * vol,
        })
        return actions, stats, returns, tickers


