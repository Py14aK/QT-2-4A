#  §7  RISK METRICS
# ══════════════════════════════════════════════════════════════════════════════

class RiskMetrics:

    @staticmethod
    def compute(returns, weights, alpha=0.95) -> dict:
        pr  = returns @ weights
        mu  = pr.mean(); sig = pr.std(ddof=1)
        var_q = np.percentile(pr, (1-alpha)*100)
        tail  = pr[pr <= var_q]
        cvar  = -tail.mean() if len(tail) else -var_q
        cum   = (1+pr).cumprod()
        dd    = ((cum - np.maximum.accumulate(cum)) / np.maximum.accumulate(cum)).min()
        return {
            "mean_return": float(round(mu, 6)),
            "volatility":  float(round(sig, 6)),
            "sharpe":      float(round((mu/(sig+1e-12))*np.sqrt(12), 4)),
            "var_95":      float(round(-var_q, 6)),
            "cvar_95":     float(round(cvar, 6)),
            "max_drawdown":float(round(dd, 4)),
            "calmar":      float(round((mu*12)/(abs(dd)+1e-12), 4)),
        }

    @staticmethod
    def comparison_table(results: List[PortfolioResult]) -> pd.DataFrame:
        return pd.DataFrame([{
            "solver":r.solver,"objective":r.objective,
            "sharpe":r.sharpe,"cvar_95":r.cvar_95,"var_95":r.var_95,
            "mean_return":r.mean_return,"volatility":r.volatility,
            "n_qubits":r.n_qubits,
        } for r in results]).sort_values("sharpe", ascending=False).reset_index(drop=True)


