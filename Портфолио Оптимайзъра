#  §4  QUANTUM PORTFOLIO SOLVER
# ══════════════════════════════════════════════════════════════════════════════

@dataclass
class QuantumSolverConfig:
    reps: int = 3; shots: int = 4096; max_iter: int = 300
    use_ibm: bool = False; ibm_channel: str = "ibm_quantum"
    ibm_token: str = ""; ibm_backend: str = "ibm_brisbane"

@dataclass
class PortfolioResult:
    objective: str; weights: np.ndarray; tickers: List[str]
    sharpe: float; cvar_95: float; var_95: float
    mean_return: float; volatility: float; solver: str
    n_qubits: int = 0; solver_trace: dict = field(default_factory=dict)

    @property
    def weight_series(self): return pd.Series(self.weights, index=self.tickers)


class QuantumPortfolioSolver:
    """QAOA-based solver. N=20, K=3 → 60 QUBO vars (local sim feasible)."""

    def __init__(self, cfg: QuantumSolverConfig):
        self.cfg = cfg
        if cfg.use_ibm:
            svc = QiskitRuntimeService(channel=cfg.ibm_channel, token=cfg.ibm_token)
            self._sampler = IBMSampler(svc.backend(cfg.ibm_backend))
        else:
            self._sampler = StatevectorSampler()

    def solve(self, qb: PortfolioQUBO, objective: str) -> PortfolioResult:
        qb.objective = objective
        qubo = QuadraticProgramToQubo().convert(qb.build())
        log.info(f"QAOA {objective}: {qb.N*qb.K} vars, p={self.cfg.reps} …")
        result = MinimumEigenOptimizer(
            QAOA(sampler=self._sampler,
                 optimizer=COBYLA(maxiter=self.cfg.max_iter),
                 reps=self.cfg.reps)
        ).solve(qubo)
        w = qb.decode_weights(result.x)
        m = RiskMetrics.compute(qb.returns, w)
        return PortfolioResult(objective=objective, weights=w,
                               tickers=qb.tickers, solver="quantum",
                               n_qubits=qb.N*qb.K, **m)


